---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((post) => {
    const related = sorted.filter((p) => p.id !== post.id).slice(0, 2);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const dateFmt = (d) => new Intl.DateTimeFormat('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
const iso = (d) => d.toISOString();

const pageTitle = `${data.title} — ELS Catalyst`;
const path = `/blogg/${post.id}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: iso(data.pubDate),
  dateModified: iso(data.updatedDate ?? data.pubDate),
  author: { '@type': 'Organization', name: 'ELS Catalyst', url: 'https://elscatalyst.se/' },
  publisher: {
    '@type': 'Organization',
    name: 'ELS Catalyst',
    logo: { '@type': 'ImageObject', url: 'https://elscatalyst.se/apple-touch-icon.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://elscatalyst.se${path}` },
};
---
<Base title={pageTitle} description={data.description} path={path} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <article class="article">
    <div class="wrap-narrow">
      <nav class="crumbs mono" aria-label="Brödsmulor">
        <a href="/">Start</a><span aria-hidden="true">/</span>
        <a href="/blogg/">Blogg</a><span aria-hidden="true">/</span>
        <span>{data.category}</span>
      </nav>

      <header class="article-head">
        <span class="art-cat mono">{data.category}</span>
        <h1>{data.title}</h1>
        <p class="art-lead">{data.description}</p>
        <div class="art-meta">
          <span class="art-byline">
            <span class="art-avatar" aria-hidden="true">EC</span>
            <span>
              <span class="art-author">{data.author}</span>
              <span class="art-dates mono">
                <time datetime={iso(data.pubDate)}>{dateFmt(data.pubDate)}</time>
                {data.readingTime && <span> · {data.readingTime} min läsning</span>}
              </span>
            </span>
          </span>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="article-foot">
        <a href="/blogg/" class="back-link mono">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M12 6.5H2m4 4-4-4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Alla artiklar
        </a>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap-narrow">
        <h2 class="related-title">Läs vidare</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a href={`/blogg/${p.id}/`} class="related-card">
              <span class="post-cat mono">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .read-progress {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    width: 0%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    z-index: var(--z-nav);
    transition: width 0.08s linear;
  }

  .article { padding: 3.5rem 0 4rem; }
  .crumbs { display: flex; gap: 0.55rem; font-size: 0.72rem; color: var(--muted); margin-bottom: 2.5rem; align-items: center; flex-wrap: wrap; }
  .crumbs a { color: var(--text-dim); text-decoration: none; transition: color 0.2s var(--ease-out); }
  .crumbs a:hover { color: var(--accent); }

  .article-head { margin-bottom: 2.5rem; }
  .art-cat { font-size: 0.72rem; color: var(--accent); letter-spacing: 0.06em; text-transform: uppercase; }
  .article-head h1 {
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 1rem 0 1.1rem;
    text-wrap: balance;
  }
  .art-lead { font-size: 1.18rem; color: var(--text-dim); line-height: 1.55; margin-bottom: 2rem; text-wrap: pretty; }
  .art-meta { padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .art-byline { display: inline-flex; align-items: center; gap: 0.8rem; }
  .art-avatar {
    width: 42px; height: 42px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--accent); color: var(--accent-ink);
    border-radius: 10px; font-weight: 800; font-size: 0.78rem; letter-spacing: -0.02em;
  }
  .art-author { display: block; font-weight: 600; font-size: 0.95rem; }
  .art-dates { display: block; font-size: 0.74rem; color: var(--muted); margin-top: 0.15rem; }

  /* ---- PROSE ---- */
  .prose { font-size: 1.075rem; line-height: 1.75; color: #d7dde3; }
  .prose > :global(*) { max-width: 68ch; }
  .prose :global(h2) {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text);
    margin: 2.6rem 0 1rem;
    text-wrap: balance;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 2rem 0 0.8rem;
  }
  .prose :global(p) { margin-bottom: 1.35rem; }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    transition: text-decoration-color 0.2s var(--ease-out);
  }
  .prose :global(a:hover) { text-decoration-color: var(--accent); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.5rem 1.3rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .prose :global(li) { padding-left: 0.3rem; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(ol) { counter-reset: item; list-style: none; margin-left: 0; }
  .prose :global(ol > li) {
    counter-increment: item;
    position: relative;
    padding-left: 2.4rem;
  }
  .prose :global(ol > li)::before {
    content: counter(item);
    position: absolute; left: 0; top: 0.05rem;
    width: 1.7rem; height: 1.7rem;
    display: grid; place-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-dim);
    border-radius: 7px;
  }
  .prose :global(blockquote) {
    margin: 1.8rem 0;
    padding: 1.2rem 1.5rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 1.1rem;
    color: var(--text);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 0.12em 0.4em;
    border-radius: 5px;
    color: var(--accent);
  }
  .prose :global(hr) { border: none; border-top: 1px solid var(--line); margin: 2.5rem 0; }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--line); margin: 1.8rem 0; }

  .article-foot { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .back-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-dim); text-decoration: none; font-size: 0.82rem; transition: color 0.2s var(--ease-out), gap 0.2s var(--ease-out); }
  .back-link:hover { color: var(--accent); gap: 0.7rem; }

  /* ---- RELATED ---- */
  .related { padding: 4rem 0 6rem; border-top: 1px solid var(--line); background: var(--bg-2); }
  .related-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 1.5rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .related-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    text-decoration: none; color: inherit;
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .related-card:hover { border-color: var(--line-bright); transform: translateY(-3px); }
  .related-card:hover h3 { color: var(--accent); }
  .post-cat { display: block; font-size: 0.68rem; color: var(--accent); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.7rem; }
  .related-card h3 { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; margin-bottom: 0.5rem; transition: color 0.2s var(--ease-out); }
  .related-card p { font-size: 0.88rem; color: var(--text-dim); line-height: 1.5; }
</style>

<script>
  const bar = document.getElementById('read-progress');
  const article = document.querySelector('.article');
  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      bar.style.width = (scrolled / Math.max(total, 1)) * 100 + '%';
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
