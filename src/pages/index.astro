---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const title = 'ELS Catalyst — Digital studio i Stockholm';
const description = 'ELS Catalyst är en oberoende digital studio i Stockholm. Vi bygger och utvecklar egna projekt på nätet.';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = (d) => new Intl.DateTimeFormat('sv-SE', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Base title={title} description={description} path="/">
  <!-- HERO -->
  <section class="hero" id="hero">
    <canvas class="hero-canvas" id="constellation" aria-hidden="true"></canvas>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 class="hero-title">Vi bygger saker <span class="hl">på nätet</span>.</h1>
      <p class="hero-sub">ELS Catalyst är en oberoende digital studio. Vi utvecklar egna projekt och långsiktiga idéer på nätet.</p>
      <div class="hero-ctas">
        <a href="#kontakt" class="btn-primary">
          Hör av dig
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#journal" class="btn-secondary">Läs journalen</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true"><span>Scrolla</span></div>
  </section>

  <!-- JOURNAL / BLOGG -->
  {posts.length > 0 && (
    <section id="journal" class="section section-journal">
      <div class="wrap">
        <header class="section-head row reveal">
          <div>
            <span class="section-index">Journal</span>
            <h2 class="section-title">Anteckningar från studion</h2>
          </div>
          <a href="/blogg/" class="head-link mono">Alla artiklar
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M1 6.5h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>
        <div class="journal-grid">
          {posts.map((p) => (
            <a href={`/blogg/${p.id}/`} class="post-card reveal">
              <span class="post-cat mono">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <time class="post-date mono" datetime={p.data.pubDate.toISOString()}>{dateFmt(p.data.pubDate)}</time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- KONTAKT -->
  <section id="kontakt" class="section section-contact">
    <div class="wrap">
      <div class="contact-head reveal">
        <span class="section-index">Kontakt</span>
        <h2 class="section-title">Hör av dig</h2>
        <p class="section-lead">För förfrågningar, samarbeten eller en pratstund.</p>
      </div>
      <ul class="contact-info reveal">
        <li>
          <span class="ci-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M3 17c0-3.3 3-5 7-5s7 1.7 7 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </span>
          <span><span class="ci-label mono">Grundare</span>Axel Jönemyr</span>
        </li>
        <li>
          <span class="ci-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="2" y="4" width="16" height="12" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="m2 5 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </span>
          <span><span class="ci-label mono">E-post</span><!--email_off--><a href="mailto:elscatalyst@proton.me">elscatalyst@proton.me</a><!--/email_off--></span>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: min(92vh, 860px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-canvas);
    display: block;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 50% 38%, transparent 40%, rgba(7,9,11,0.55) 100%),
      linear-gradient(180deg, rgba(7,9,11,0.35) 0%, transparent 22%, transparent 68%, var(--bg) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 6rem 1.75rem 5rem;
    pointer-events: none;
  }
  .hero-inner a, .hero-inner button { pointer-events: auto; }

  .hero-title {
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 18ch;
    margin: 0 auto 1.4rem;
    text-wrap: balance;
  }
  .hero-title .hl { color: var(--accent); }
  .hero-sub {
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    color: var(--text-dim);
    max-width: 56ch;
    margin: 0 auto 2.4rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .hero-ctas {
    display: inline-flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-scroll::after {
    content: '';
    width: 1px; height: 34px;
    background: linear-gradient(var(--accent), transparent);
    animation: scrollpulse 2.2s var(--ease-out) infinite;
  }
  @keyframes scrollpulse {
    0% { opacity: 0; transform: scaleY(0.3); transform-origin: top; }
    45% { opacity: 1; transform: scaleY(1); transform-origin: top; }
    100% { opacity: 0; transform: scaleY(1); transform-origin: bottom; }
  }

  /* ===== SECTIONS ===== */
  .section { padding: 7rem 0; position: relative; }
  .section-head { max-width: 640px; margin-bottom: 3.5rem; }
  .section-head.row {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .section-index {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .section-index::before {
    content: '';
    width: 14px; height: 1px;
    background: var(--accent);
    display: inline-block;
  }
  .section-title {
    font-size: clamp(1.9rem, 3.6vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1rem;
    text-wrap: balance;
  }
  .section-lead {
    font-size: 1.05rem;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 56ch;
  }
  .head-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    transition: color 0.2s var(--ease-out), gap 0.2s var(--ease-out);
    white-space: nowrap;
    padding-bottom: 0.4rem;
  }
  .head-link:hover { color: var(--accent); gap: 0.7rem; }

  /* ===== JOURNAL ===== */
  .section-journal { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .post-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-height: 220px;
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .post-card:hover { border-color: var(--line-bright); transform: translateY(-3px); }
  .post-card:hover h3 { color: var(--accent); }
  .post-cat { font-size: 0.68rem; color: var(--accent); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.9rem; }
  .post-card h3 { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; margin-bottom: 0.6rem; transition: color 0.2s var(--ease-out); }
  .post-card p { font-size: 0.9rem; color: var(--text-dim); line-height: 1.55; margin-bottom: 1.2rem; }
  .post-date { font-size: 0.72rem; color: var(--muted); margin-top: auto; }

  /* ===== CONTACT ===== */
  .contact-head { max-width: 640px; margin-bottom: 2.5rem; }
  .contact-info {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .contact-info li {
    display: flex; align-items: center; gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    transition: border-color 0.2s var(--ease-out);
  }
  .contact-info li:hover { border-color: var(--line-bright); }
  .ci-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--surface-2);
    border: 1px solid var(--line-bright);
    border-radius: 9px;
    color: var(--accent);
  }
  .contact-info li > span:last-child { display: flex; flex-direction: column; font-weight: 500; font-size: 0.95rem; min-width: 0; }
  .contact-info li > span:last-child > a { overflow-wrap: anywhere; }
  .ci-label { font-size: 0.66rem; color: var(--muted); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.15rem; font-weight: 400; }
  .contact-info a { color: var(--text); text-decoration: none; transition: color 0.2s var(--ease-out); }
  .contact-info a:hover { color: var(--accent); }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .section { padding: 5rem 0; }
  }
  @media (max-width: 560px) {
    .hero-inner { padding: 5rem 1.25rem 4rem; }
    .section-head.row { align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll::after { animation: none; }
  }
</style>

<script>
  // ---------- Interactive constellation ----------
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('constellation');
  const hero = document.getElementById('hero');
  if (canvas && hero && canvas.getContext) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const accent = [124, 255, 158];
    let w = 0, h = 0, dpr = 1;
    let particles = [];
    let raf = 0, running = false;
    const mouse = { x: -9999, y: -9999, active: false };

    const conf = () => {
      const area = w * h;
      const target = Math.min(Math.max(Math.round(area / 12000), 28), 120);
      return { count: target, link: Math.min(Math.max(w * 0.11, 110), 170), mouseR: 190 };
    };
    let C = { count: 60, link: 140, mouseR: 190 };

    function resize() {
      const r = hero.getBoundingClientRect();
      w = r.width; h = r.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      C = conf();
      seed();
    }

    function seed() {
      particles = [];
      for (let i = 0; i < C.count; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.28,
          vy: (Math.random() - 0.5) * 0.28,
          r: Math.random() * 1.4 + 0.8,
        });
      }
    }

    function step() {
      ctx.clearRect(0, 0, w, h);
      const link = C.link, mouseR = C.mouseR;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        p.x = Math.max(0, Math.min(w, p.x));
        p.y = Math.max(0, Math.min(h, p.y));

        if (mouse.active) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < mouseR * mouseR && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const f = (1 - d / mouseR) * 0.9;
            p.x += (dx / d) * f;
            p.y += (dy / d) * f;
          }
        }
      }

      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < link) {
            const al = (1 - d / link) * 0.34;
            ctx.strokeStyle = `rgba(${accent[0]},${accent[1]},${accent[2]},${al})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }

        if (mouse.active) {
          const dx = a.x - mouse.x, dy = a.y - mouse.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < mouseR) {
            const al = (1 - d / mouseR) * 0.6;
            ctx.strokeStyle = `rgba(${accent[0]},${accent[1]},${accent[2]},${al})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
      }

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        let glow = 0.5;
        if (mouse.active) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < mouseR) glow = 0.5 + (1 - d / mouseR) * 0.5;
        }
        ctx.fillStyle = `rgba(${accent[0]},${accent[1]},${accent[2]},${glow})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }

      raf = requestAnimationFrame(step);
    }

    function start() { if (!running) { running = true; raf = requestAnimationFrame(step); } }
    function stop() { running = false; cancelAnimationFrame(raf); }

    function staticFrame() {
      resize();
      const link = C.link;
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < link) {
            ctx.strokeStyle = `rgba(${accent[0]},${accent[1]},${accent[2]},${(1 - d / link) * 0.28})`;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      for (const p of particles) {
        ctx.fillStyle = `rgba(${accent[0]},${accent[1]},${accent[2]},0.5)`;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
      }
    }

    function toLocal(clientX, clientY) {
      const r = canvas.getBoundingClientRect();
      mouse.x = clientX - r.left;
      mouse.y = clientY - r.top;
      mouse.active = true;
    }
    hero.addEventListener('mousemove', (e) => toLocal(e.clientX, e.clientY));
    hero.addEventListener('mouseleave', () => { mouse.active = false; mouse.x = -9999; mouse.y = -9999; });
    hero.addEventListener('touchmove', (e) => {
      if (e.touches[0]) toLocal(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
    hero.addEventListener('touchend', () => { mouse.active = false; });

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => { if (reduce) staticFrame(); else resize(); }, 150);
    });

    if (reduce) {
      staticFrame();
    } else {
      resize();
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { e.isIntersecting ? start() : stop(); });
      }, { threshold: 0.02 });
      io.observe(hero);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop(); else if (isVisible()) start();
      });
      function isVisible() {
        const r = hero.getBoundingClientRect();
        return r.bottom > 0 && r.top < window.innerHeight;
      }
      start();
    }
  }
</script>
