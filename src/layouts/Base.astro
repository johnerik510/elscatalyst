---
import '../styles/global.css';

const {
  title,
  description,
  path = '/',
  ogImage = '/og-image.jpg',
  type = 'website',
} = Astro.props;

const site = 'https://elscatalyst.se';
const canonical = new URL(path, site).href;
const ogUrl = new URL(ogImage, site).href;
const year = new Date().getFullYear();

const nav = [
  { href: '/blogg/', label: 'Journal' },
];
---
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#07090b" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:locale" content="sv_SE" />
  <meta property="og:site_name" content="ELS Catalyst" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <slot name="head" />
  <script is:inline>
    // Arm scroll-reveal before first paint so content is only ever hidden when
    // JS can also reveal it. Without JS / in headless renderers, content stays visible.
    (function () {
      try {
        var ok = 'IntersectionObserver' in window &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (ok) document.documentElement.classList.add('reveal-ready');
      } catch (e) {}
    })();
  </script>
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="1HGf4g9y1OHuJq4OLdOFOg" async></script>
</head>
<body>
  <a href="#main" class="skip-link">Hoppa till innehåll</a>

  <header class="site-header" id="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo" aria-label="ELS Catalyst — startsida">
        <span class="logo-text">ELS&nbsp;<b>Catalyst</b></span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Öppna meny" aria-expanded="false" aria-controls="primary-nav">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
      <nav class="nav" id="primary-nav" aria-label="Huvudmeny">
        {nav.map((n) => <a href={n.href} class="nav-link">{n.label}</a>)}
        <a href="/#kontakt" class="btn-nav"><span class="status-dot" aria-hidden="true"></span>Kontakt</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a href="/" class="logo">
            <span class="logo-text">ELS&nbsp;<b>Catalyst</b></span>
          </a>
          <p class="footer-blurb">En oberoende digital studio i Stockholm.</p>
        </div>
        <div class="footer-col">
          <h5>Meny</h5>
          <ul>
            <li><a href="/">Start</a></li>
            <li><a href="/blogg/">Journal</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h5>Kontakt</h5>
          <ul>
            <!--email_off--><li><a href="mailto:elscatalyst@proton.me">elscatalyst@proton.me</a></li><!--/email_off-->
          </ul>
        </div>
      </div>
      <div class="footer-base">
        <span class="footer-copy">&copy; {year} ELS Catalyst — Stockholm</span>
        <span class="footer-disclosure">Vissa artiklar på bloggen kan innehålla annonssamarbeten eller sponsrade länkar. De märks alltid ut tydligt.</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var header = document.getElementById('site-header');
      var onScroll = function () {
        if (!header) return;
        header.setAttribute('data-scrolled', String(window.scrollY > 8));
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      var toggle = document.getElementById('nav-toggle');
      var nav = document.getElementById('primary-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Stäng meny' : 'Öppna meny');
        });
        nav.addEventListener('click', function (e) {
          if (e.target.closest('a')) {
            nav.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Scroll reveal: only runs when armed (.reveal-ready set in head).
      var revealEls = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
      if (document.documentElement.classList.contains('reveal-ready') && revealEls.length) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealEls.forEach(function (el) { io.observe(el); });
        // Safety net: if anything never intersects (odd viewports), reveal it.
        setTimeout(function () { revealEls.forEach(function (el) { el.classList.add('is-in'); }); }, 2600);
      }
    })();
  </script>
</body>
</html>
