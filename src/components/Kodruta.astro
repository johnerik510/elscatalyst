---
/**
 * Kodruta: rabattkod eller kampanj under köpknappen, bara medan kampanjen pågår.
 * Skrivs av scripts/kampanjer/bloggar.mjs (ändra där, inte här). Data:
 * src/data/kampanjer.generated.json, som uppdateras varje natt.
 */
import rad from '../data/kampanjer.generated.json';

const nu = Date.now();
const lista = ((rad as any).rader || [])
  .filter((r: any) => !r.till || Date.parse(r.till) > nu)
  .map((r: any) => [r.kod || '', r.spara, r.mer || '', r.villkor || '', r.fran || '', r.till || '', r.ar || '', r.td || '', r.atv || '', r.dom || '', (r.undantag || []).join('|'), r.butik]);
const ord = ["Kopiera","Kopierad","Ange koden i kassan.","med koden","Ingen kod behövs."];
---
{lista.length > 0 && (
  <script is:inline define:vars={{ lista, ord }}>
    (function () {
      var t = Date.now();
      function bas(h) { var x = String(h || '').toLowerCase().replace(/^www\./, '').split('.'); return x.length <= 2 ? x.join('.') : x.slice(-2).join('.'); }
      function las(href) {
        var u; try { u = new URL(href, location.href); } catch (e) { return null; }
        var h = u.hostname.toLowerCase(), q = u.searchParams, m = q.get('u') || q.get('url') || '', o = { ar: '', td: '', at: '', d: '', s: '' };
        if (/addrevenue\.io$/.test(h)) o.ar = q.get('a') || '';
        else if (/tradedoubler\.com$/.test(h)) { o.td = q.get('p') || ((u.href.match(/p\((\d+)\)/) || [])[1] || ''); if (!m) m = (u.href.match(/url\((https?[^)]+)\)/) || [])[1] || ''; }
        else if (u.pathname === '/t/t') o.at = h;
        try { m = decodeURIComponent(m); } catch (e) {}
        if (/^https?:/i.test(m)) { try { var w = new URL(m); o.d = bas(w.hostname); o.s = (w.pathname + w.search).toLowerCase(); } catch (e) {} }
        return o;
      }
      function valj(href) {
        var o = las(href); if (!o) return null;
        for (var i = 0; i < lista.length; i++) {
          var x = lista[i];
          if (x[4] && Date.parse(x[4]) > t) continue;
          if (x[5] && Date.parse(x[5]) <= t) continue;
          var ok = (x[6] && x[6] === o.ar) || (x[7] && x[7] === o.td) || (x[8] && x[8] === o.at) || (x[9] && x[9] === o.d);
          if (!ok) continue;
          if (x[10] && o.s && x[10].split('|').some(function (y) { return y && o.s.indexOf(y) > -1; })) continue;
          return x;
        }
        return null;
      }
      function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
      function bygg(x) {
        var b = el('div', 'kdr'); b.setAttribute('data-kdr', x[11]); b.setAttribute('data-nosnippet', '');
        var t1 = el('p', 'kdr-t'); t1.append(el('b', '', x[1]), document.createTextNode(' ' + (x[2] || (x[0] ? ord[3] : ''))));
        b.append(t1);
        if (x[0]) {
          var r = el('div', 'kdr-r'), k = el('span', 'kdr-k', x[0]), c = el('button', 'kdr-c', ord[0]), s = el('span', '', '');
          k.setAttribute('translate', 'no'); c.type = 'button'; c.setAttribute('aria-label', ord[0] + ' ' + x[0]);
          s.setAttribute('role', 'status'); s.style.cssText = 'position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)';
          c.addEventListener('click', function () {
            (navigator.clipboard ? navigator.clipboard.writeText(x[0]) : Promise.reject()).catch(function () {
              var g = document.createRange(); g.selectNodeContents(k); var z = getSelection(); z.removeAllRanges(); z.addRange(g); document.execCommand('copy');
            }).then(function () { c.textContent = ord[1]; s.textContent = ord[1] + ': ' + x[0]; setTimeout(function () { c.textContent = ord[0]; s.textContent = ''; }, 2200); });
          });
          r.append(k, c, s); b.append(r);
          b.append(el('p', 'kdr-v', (x[3] ? x[3] + ' ' : '') + ord[2]));
        } else {
          b.append(el('p', 'kdr-v', (x[3] || '').replace(/\s*(Ingen kod behövs|Ingen kode trengs)\.?$/, '') + ' ' + ord[4]));
        }
        return b;
      }
      var as = document.querySelectorAll('main a[href][rel*="sponsored"]');
      for (var i = 0; i < as.length; i++) {
        var a = as[i];
        if (a.closest('header, nav, footer, dialog, [data-kdr-ej], .kdr-h') || a.querySelector('img, picture')) continue;
        var x = valj(a.getAttribute('href')); if (!x) continue;
        var cs = getComputedStyle(a);
        if (cs.display === 'inline' || cs.backgroundColor === 'rgba(0, 0, 0, 0)' && cs.borderTopStyle === 'none') continue;
        var fast = false; for (var n = a; n && n !== document.body; n = n.parentElement) { var ps = getComputedStyle(n).position; if (ps === 'fixed' || ps === 'sticky') { fast = true; break; } }
        if (fast) continue;
        var h = el('div', 'kdr-h');
        ['gridColumn', 'gridRow', 'alignSelf', 'justifySelf', 'order', 'flex'].forEach(function (q) { var v = cs[q]; if (v && ['auto', 'auto / auto', '0', 'normal', '0 1 auto'].indexOf(v) < 0) h.style[q] = v; });
        a.replaceWith(h); h.append(a, bygg(x));
      }
    })();
  </script>
)}

<style is:global>
  .kdr-h { display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
  .kdr { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .6rem; border-left: 3px solid #33d986; background: #0f1714; color: #eef1f4; border-radius: 0 8px 8px 0; padding: .5rem .7rem; font-size: .875rem; line-height: 1.4; text-align: left; }
  .kdr-t { margin: 0; flex: 1 1 12rem; }
  .kdr-t b { color: #33d986; font-weight: 800; }
  .kdr-r { display: inline-flex; align-items: stretch; gap: 0; }
  .kdr-k { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 .7rem; background: #0a0f0d; border: 1px solid #33d986; border-right: 0; font: 700 1rem/1 ui-monospace, Menlo, monospace; user-select: all; }
  .kdr-c { min-height: 2.75rem; padding: 0 .85rem; border: 1px solid #33d986; background: #33d986; color: #052012; font: inherit; font-weight: 700; cursor: pointer; }
  .kdr-v { margin: 0; flex-basis: 100%; font-size: .78rem; color: #a4adb7; }
  @media (prefers-reduced-motion: reduce) { .kdr-c { transition: none; } }
</style>
